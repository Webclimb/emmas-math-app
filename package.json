{
  "name": "number-sky",
  "version": "2.0.0-m0",
  "private": true,
  "type": "module",
  "description": "Number Sky: maths practice for a learner with dyscalculia. Builds to one self-contained index.html.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "accept": "npm run typecheck && vitest run && vite build && playwright test && node scripts/criteria.mjs",
    "criteria": "node scripts/criteria.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
